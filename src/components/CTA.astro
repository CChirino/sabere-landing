---
---

<section id="contacto" class="bg-white px-4 pb-16 sm:px-6 lg:pb-24">
  <div class="mx-auto max-w-6xl rounded-3xl bg-ink-900 px-6 py-16 text-center sm:px-12 lg:py-20" data-reveal>
    <h2 class="mx-auto max-w-2xl font-serif text-3xl font-semibold leading-snug text-white sm:text-4xl">
      ¿Listo para transformar tu experiencia escolar?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-white/60">
      Únete a miles de familias que ya están construyendo un futuro más
      conectado y organizado.
    </p>
    <form id="contact-form" class="mx-auto mt-10 grid max-w-2xl gap-4 text-left sm:grid-cols-2">
      <div class="sm:col-span-1">
        <label for="cta-nombre" class="sr-only">Nombre</label>
        <input
          id="cta-nombre"
          name="nombre"
          type="text"
          required
          placeholder="Nombre completo"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-1">
        <label for="cta-correo" class="sr-only">Correo</label>
        <input
          id="cta-correo"
          name="correo"
          type="email"
          required
          placeholder="Correo electrónico"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-1">
        <label for="cta-telefono" class="sr-only">Teléfono</label>
        <input
          id="cta-telefono"
          name="telefono"
          type="tel"
          placeholder="Teléfono"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-1">
        <label for="cta-colegio" class="sr-only">Colegio</label>
        <input
          id="cta-colegio"
          name="colegio"
          type="text"
          placeholder="Colegio"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-2">
        <label for="cta-mensaje" class="sr-only">Mensaje</label>
        <textarea
          id="cta-mensaje"
          name="mensaje"
          rows="4"
          required
          placeholder="Cuéntanos qué necesitas"
          class="w-full resize-none rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        ></textarea>
      </div>
      <div class="sm:col-span-2 flex justify-center">
        <button
          type="submit"
          class="rounded-full bg-teal-600 px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-teal-500 hover:shadow-lg"
        >
          Enviar mensaje
        </button>
      </div>
    </form>
    <p class="mt-6 text-xs text-white/40">
      Te responderemos a la brevedad a contacto@sabereapp.com.
    </p>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const nombre = String(data.get("nombre") ?? "").trim();
    const correo = String(data.get("correo") ?? "").trim();
    const telefono = String(data.get("telefono") ?? "").trim();
    const colegio = String(data.get("colegio") ?? "").trim();
    const mensaje = String(data.get("mensaje") ?? "").trim();

    const subject = `Contacto desde la web - ${nombre}`;
    const body = [
      `Nombre: ${nombre}`,
      `Correo: ${correo}`,
      `Teléfono: ${telefono || "No especificado"}`,
      `Colegio: ${colegio || "No especificado"}`,
      "",
      "Mensaje:",
      mensaje,
    ].join("\n");

    const mailtoLink = `mailto:contacto@sabereapp.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailtoLink;
  });
</script>
