---
---

<section id="contacto" class="bg-white px-4 pb-16 sm:px-6 lg:pb-24">
  <div class="mx-auto max-w-6xl rounded-3xl bg-ink-900 px-6 py-16 text-center sm:px-12 lg:py-20" data-reveal>
    <h2 class="mx-auto max-w-2xl font-serif text-3xl font-semibold leading-snug text-white sm:text-4xl">
      ¿Listo para transformar tu experiencia escolar?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-white/60">
      Únete a miles de familias que ya están construyendo un futuro más
      conectado y organizado.
    </p>
    <form id="contact-form" class="mx-auto mt-10 grid max-w-2xl gap-4 text-left sm:grid-cols-2">
      <div class="sm:col-span-1">
        <label for="cta-nombre" class="sr-only">Nombre</label>
        <input
          id="cta-nombre"
          name="nombre"
          type="text"
          required
          placeholder="Nombre completo"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-1">
        <label for="cta-correo" class="sr-only">Correo</label>
        <input
          id="cta-correo"
          name="correo"
          type="email"
          required
          placeholder="Correo electrónico"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-1">
        <label for="cta-telefono" class="sr-only">Teléfono</label>
        <input
          id="cta-telefono"
          name="telefono"
          type="tel"
          placeholder="Teléfono"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-1">
        <label for="cta-colegio" class="sr-only">Colegio</label>
        <input
          id="cta-colegio"
          name="colegio"
          type="text"
          placeholder="Colegio"
          class="w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        />
      </div>
      <div class="sm:col-span-2">
        <label for="cta-mensaje" class="sr-only">Mensaje</label>
        <textarea
          id="cta-mensaje"
          name="mensaje"
          rows="4"
          required
          placeholder="Cuéntanos qué necesitas"
          class="w-full resize-none rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-teal-400 focus:bg-white/10"
        ></textarea>
      </div>
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />
      <div class="sm:col-span-2 flex justify-center">
        <button
          type="submit"
          class="rounded-full bg-teal-600 px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-teal-500 hover:shadow-lg disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-y-0"
        >
          Enviar mensaje
        </button>
      </div>
      <p id="contact-status" role="status" aria-live="polite" class="sm:col-span-2 hidden text-center text-sm"></p>
    </form>
    <p class="mt-6 text-xs text-white/40">
      Te responderemos a la brevedad a contacto@sabereapp.com.
    </p>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

  const showStatus = (text: string, ok: boolean) => {
    if (!status) return;
    status.textContent = text;
    status.classList.remove("hidden", "text-teal-300", "text-red-300");
    status.classList.add(ok ? "text-teal-300" : "text-red-300");
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    if (data.get("botcheck")) return;

    const nombre = String(data.get("nombre") ?? "").trim();
    const correo = String(data.get("correo") ?? "").trim();
    const telefono = String(data.get("telefono") ?? "").trim();
    const colegio = String(data.get("colegio") ?? "").trim();
    const mensaje = String(data.get("mensaje") ?? "").trim();

    if (!nombre || !correo || !mensaje) {
      showStatus("Por favor completa nombre, correo y mensaje.", false);
      return;
    }
    if (!accessKey) {
      console.error("Falta la variable PUBLIC_WEB3FORMS_KEY");
      showStatus("No se pudo enviar el mensaje. Escríbenos a contacto@sabereapp.com.", false);
      return;
    }

    if (button) {
      button.disabled = true;
      button.textContent = "Enviando...";
    }

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `Contacto desde la web - ${nombre}`,
          from_name: "Landing Saberé",
          replyto: correo,
          nombre,
          correo,
          telefono: telefono || "No especificado",
          colegio: colegio || "No especificado",
          mensaje,
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) throw new Error(result.message || `HTTP ${response.status}`);

      form.reset();
      showStatus("¡Gracias! Recibimos tu mensaje y te responderemos pronto.", true);
    } catch (error) {
      console.error("Error enviando el formulario:", error);
      showStatus("No se pudo enviar el mensaje. Inténtalo de nuevo o escríbenos a contacto@sabereapp.com.", false);
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = "Enviar mensaje";
      }
    }
  });
</script>
