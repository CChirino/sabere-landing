---
const faqs = [
  {
    q: "¿Qué es Saberé?",
    a: "Saberé es una plataforma de comunicación y gestión escolar que conecta a los padres con la vida educativa de sus hijos: comunicación directa con maestros, calendario unificado de tareas, pagos escolares y seguimiento del progreso académico y emocional, todo en un solo lugar.",
  },
  {
    q: "¿Cuánto cuesta Saberé?",
    a: "Puedes crear una cuenta gratuita sin tarjeta de crédito. La configuración toma menos de 5 minutos.",
  },
  {
    q: "¿Para qué edades o niveles escolares funciona?",
    a: "Saberé acompaña a las familias desde preescolar hasta el último año escolar. La plataforma evoluciona junto con el ciclo educativo de tus hijos.",
  },
  {
    q: "¿Es seguro para los datos de mis hijos?",
    a: "Sí. Utilizamos encriptación de grado institucional para proteger los datos de los estudiantes y sus familias. La seguridad y confianza son pilares de la plataforma.",
  },
  {
    q: "¿Cómo ayuda Saberé a la comunicación con la escuela?",
    a: "Saberé elimina los cientos de correos y grupos de chat dispersos: los padres se comunican directamente con maestros y directivos desde la plataforma, sin barreras ni esperas innecesarias.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="bg-lavender-50 py-16 lg:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center" data-reveal>
      <h2 class="font-serif text-3xl font-semibold text-teal-800 sm:text-4xl">
        Preguntas frecuentes
      </h2>
      <p class="mt-3 text-sm text-ink-800/60">
        Todo lo que necesitas saber sobre Saberé.
      </p>
    </div>

    <div class="mt-10 space-y-4" data-reveal style="--reveal-delay: 120ms">
      {faqs.map((f) => (
        <details class="group rounded-2xl bg-white p-6 shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-ink-900 [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 shrink-0 text-teal-700 transition-transform duration-300 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-800/70">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
