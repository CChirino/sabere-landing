---
---

<section id="caracteristicas" class="bg-lavender-100 py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="font-serif text-3xl font-semibold text-teal-800 sm:text-4xl">
        Diseñado para la vida real
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-800/60">
        Entendemos el ritmo de las familias modernas. Saberé simplifica lo
        complejo para que te enfoques en lo que importa.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      <!-- Card: Ahorra tiempo valioso -->
      <article
        class="rounded-3xl bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg lg:col-span-2"
        data-reveal
      >
        <div class="grid items-center gap-8 sm:grid-cols-2">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-teal-50 text-teal-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <h3 class="mt-4 text-lg font-semibold text-ink-900">Ahorra tiempo valioso</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-800/60">
              Centraliza toda la información escolar en una sola vista intuitiva.
              Olvida los cientos de correos y grupos de chat.
            </p>
            <ul class="mt-4 space-y-2 text-sm text-ink-800/70">
              <li class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Calendario unificado de tareas
              </li>
              <li class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Pagos en un solo click
              </li>
            </ul>
          </div>
          <!-- Foto: Brandon Cormier / Unsplash -->
          <img
            src="/images/agenda-cafe.webp"
            alt="Cuaderno abierto con pluma y taza de café"
            class="aspect-[4/3] w-full rounded-2xl object-cover"
            loading="lazy"
          />
        </div>
      </article>

      <!-- Card: Comunicación Fluida -->
      <article
        class="flex flex-col justify-between rounded-3xl bg-cream-100 p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <div>
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-amber-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8m-8 4h5m-9 6l3.2-3.2A2 2 0 018.6 16H18a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v14z" />
            </svg>
          </span>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">Comunicación Fluida</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-800/60">
            Conecta directamente con maestros y directivos sin barreras ni esperas
            innecesarias.
          </p>
        </div>
        <div class="mt-6 flex gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-900/15"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-900/15"></span>
        </div>
      </article>

      <!-- Card: Comunidad Saberé -->
      <article
        class="rounded-3xl bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg lg:col-span-2"
        data-reveal
      >
        <div class="grid items-center gap-8 sm:grid-cols-2">
          <!-- Foto: LinkedIn Sales Solutions / Unsplash -->
          <img
            src="/images/comunidad.webp"
            alt="Grupo de padres conversando alrededor de una mesa"
            class="aspect-[4/3] w-full rounded-2xl object-cover"
            loading="lazy"
          />
          <div>
            <span class="inline-block rounded-full bg-amber-500/15 px-3 py-1 text-xs font-semibold text-amber-600">NUEVO</span>
            <h3 class="mt-3 text-lg font-semibold text-ink-900">Comunidad Saberé</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-800/60">
              Accede a talleres, artículos y recursos exclusivos para padres que
              quieren potenciar el aprendizaje en casa.
            </p>
            <a href="#" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-teal-700 transition hover:text-teal-800">
              Explorar recursos
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </article>

      <!-- Card: Seguimiento Real -->
      <article
        class="flex flex-col justify-between rounded-3xl bg-teal-800 p-8 text-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <div>
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </span>
          <h3 class="mt-4 text-lg font-semibold">Seguimiento Real</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            Visualiza el progreso académico y emocional de tus hijos con gráficas
            amigables y claras.
          </p>
        </div>
        <div class="mt-8 space-y-2">
          <div class="h-2 w-full rounded-full bg-white/15">
            <div class="h-2 w-3/4 rounded-full bg-amber-400"></div>
          </div>
          <div class="h-2 w-full rounded-full bg-white/15">
            <div class="h-2 w-1/2 rounded-full bg-white/60"></div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
