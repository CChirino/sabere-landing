---
import LogoMark from "./LogoMark.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-lavender-200/60 bg-white">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6">
    <a href="/" class="flex items-center gap-1" aria-label="Saberé">
      <LogoMark class="h-8 w-8" />
      <span class="font-logo text-xl font-bold leading-none text-brand">aberé</span>
    </a>

    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-ink-800/50">
      <a href="#" class="transition hover:text-teal-800">Política de privacidad</a>
      <a href="#" class="transition hover:text-teal-800">Términos del servicio</a>
      <a href="#" class="transition hover:text-teal-800">Centro de ayuda</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://www.instagram.com/sabere.app/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de Saberé"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-lavender-100 text-ink-800/60 transition hover:bg-brand hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a
        href="https://www.linkedin.com/company/sabereapp/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn de Saberé"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-lavender-100 text-ink-800/60 transition hover:bg-brand hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.78 2.65 4.78 6.1V24h-4v-8.5c0-2.03-.04-4.64-2.83-4.64-2.83 0-3.27 2.21-3.27 4.5V24H8V8z" />
        </svg>
      </a>
    </div>
  </div>
  <div class="border-t border-lavender-200/40 py-4 text-center text-xs text-ink-800/40">
    © {year} Saberé. Cultivando el futuro juntos.
  </div>
</footer>
