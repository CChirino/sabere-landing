---
import LogoMark from "./LogoMark.astro";

const navLinks = [
  { label: "Beneficios", href: "#beneficios" },
  { label: "Características", href: "#caracteristicas" },
  { label: "Familia", href: "#familia" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-lavender-200/60 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-1" aria-label="Saberé">
      <LogoMark class="h-9 w-9" />
      <span class="font-logo text-2xl font-bold leading-none text-brand">aberé</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-ink-800/70 transition hover:text-teal-800">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a href="#" class="text-sm font-medium text-ink-800/80 transition hover:text-teal-800">Iniciar sesión</a>
      <a
        href="#contacto"
        class="rounded-full bg-teal-800 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-700"
      >
        Comenzar
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-lg text-ink-800 md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-lavender-200/60 bg-white px-4 pb-6 pt-4 md:hidden">
    <nav class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-ink-800/80">{link.label}</a>
      ))}
      <hr class="border-lavender-200" />
      <a href="#" class="text-sm font-medium text-ink-800/80">Iniciar sesión</a>
      <a href="#contacto" class="rounded-full bg-teal-800 px-5 py-2.5 text-center text-sm font-semibold text-white">
        Comenzar
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );
</script>
