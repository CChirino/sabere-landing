---
---

<section id="beneficios" class="bg-gradient-to-b from-blush-50 via-lavender-50 to-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24">
    <div data-reveal>
      <span class="inline-block rounded-full bg-cream-100 px-4 py-1.5 text-xs font-semibold tracking-wide text-amber-600">
        CERCANÍA FAMILIAR
      </span>
      <h1 class="mt-5 font-serif text-4xl font-semibold leading-tight text-ink-900 sm:text-5xl lg:text-[3.4rem]">
        Conéctate con el <em class="italic text-teal-700">futuro</em> de tus hijos.
      </h1>
      <p class="mt-5 max-w-md text-base leading-relaxed text-ink-800/70">
        Saberé es el puente que une la educación con el corazón del hogar. Una
        plataforma diseñada para que los padres vivan cada paso del crecimiento
        escolar con paz y claridad.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-full bg-teal-800 px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:-translate-y-0.5 hover:bg-teal-700 hover:shadow-lg"
        >
          Comenzar hoy
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-full border border-ink-900/15 bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition duration-300 hover:-translate-y-0.5 hover:border-teal-700 hover:text-teal-700"
        >
          Ver video
        </a>
      </div>
    </div>

    <div class="relative" data-reveal style="--reveal-delay: 150ms">
      <div class="rounded-3xl bg-cream-100 p-3 shadow-xl shadow-teal-900/5">
        <!-- Foto: Vitaly Gariev / Unsplash -->
        <img
          src="/images/hero-familia.webp"
          alt="Familia feliz sentada en el sofá de su casa"
          class="aspect-[4/3] w-full rounded-2xl object-cover"
          fetchpriority="high"
        />
      </div>
      <div class="animate-float absolute -bottom-6 right-4 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-lg sm:right-8">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-500/15 text-amber-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5L8 13.8 2 9.2h7.6z" />
          </svg>
        </span>
        <div>
          <p class="text-xs font-semibold text-ink-900">Logro ACADÉMICO</p>
          <p class="text-xs text-ink-800/60">¡Carlos aprobó su examen!</p>
        </div>
      </div>
    </div>
  </div>
</section>
