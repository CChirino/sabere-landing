---
interface Props {
  class?: string;
}
const { class: className = "h-9 w-9" } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class={className} aria-hidden="true">
  <g stroke-linejoin="round">
    <polygon points="50,7 87,28.5 87,71.5 50,93 13,71.5 13,28.5" fill="#237e83" stroke="#237e83" stroke-width="12"></polygon>
    <polygon points="50,16 79,33 79,67 50,84 21,67 21,33" fill="none" stroke="#1e1b2e" stroke-width="5" stroke-linejoin="round"></polygon>
  </g>
  <text x="50" y="69" font-family="Arial, Helvetica, sans-serif" font-size="54" font-weight="900" text-anchor="middle" fill="#ffffff">S</text>
</svg>
