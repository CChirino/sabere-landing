---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Saberé — Conéctate con el futuro de tus hijos",
  description = "Saberé es el puente que une la educación con el corazón del hogar. Una plataforma diseñada para que los padres vivan cada paso del crecimiento escolar con paz y claridad.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.jpg", Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sabereapp.com/#organization",
      name: "Saberé",
      url: "https://sabereapp.com",
      logo: "https://sabereapp.com/favicon.svg",
      description:
        "Plataforma educativa que conecta a las familias con la vida escolar de sus hijos: comunicación con maestros, calendario unificado, pagos y seguimiento académico.",
      sameAs: [
        "https://www.instagram.com/sabere.app/",
        "https://www.linkedin.com/company/sabereapp/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://sabereapp.com/#website",
      url: "https://sabereapp.com",
      name: "Saberé",
      inLanguage: "es",
      publisher: { "@id": "https://sabereapp.com/#organization" },
    },
    {
      "@type": "SoftwareApplication",
      name: "Saberé",
      applicationCategory: "EducationalApplication",
      operatingSystem: "Web",
      url: "https://sabereapp.com",
      description:
        "Saberé es una plataforma de comunicación escolar para familias: centraliza tareas, calendario, pagos, comunicación directa con maestros y seguimiento del progreso académico y emocional de los hijos.",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        description: "Cuenta gratuita disponible",
      },
      publisher: { "@id": "https://sabereapp.com/#organization" },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Saberé" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@700;800&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen bg-white antialiased">
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
